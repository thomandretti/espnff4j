{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "packageRules": [
    {
      "matchDatasources": ["java-version"],
      "matchUpdateTypes": ["major"],
      "enabled": false,
      "description": "detekt 1.23.x cannot run on JDK 22+; re-enable once on detekt 2.0 stable"
    }
  ]
}
